              "time_spent"
            ]
          }
        },
        "required": [
          "table",
          "column"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "formula.evaluate",
      "label": "Calculer une formule",
      "description": "Calcule une formule sur une table sans rien modifier (ex. =SUM(C1:C3)).",
      "kind": "read",
      "output": {
        "format": "json",
        "schema": {
          "type": "object",
          "properties": {
            "formula": {
              "type": "string"
            },
            "value": {
              "type": [
                "string",
