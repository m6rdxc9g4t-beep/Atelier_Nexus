# ─── Application ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:3000

# ─── Base de données (PostgreSQL + pgvector) ──────────────────
# En Docker, l'hôte est le nom du service : postgres
DATABASE_URL=postgresql+asyncpg://atelier:change-me@localhost:5432/atelier_hub

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Routeur LLM ──────────────────────────────────────────────
# Fournisseur par défaut : anthropic | ollama
LLM_DEFAULT_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ollama (modèles locaux) — en Docker : http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ─── Apps Atelier ─────────────────────────────────────────────
DATA_VIA_BASE_URL=
DATA_VIA_API_KEY=

# ─── GitHub (Studio Dev : branches / PR générées par les agents)
GITHUB_TOKEN=
GITHUB_REPO=
