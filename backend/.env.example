# ─── Application ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# Origines autorisées (CORS), séparées par des virgules
# Nexus : UI 3100 / API 8100 (3000 et 8000 sont réservés à Atelier Projets et Atelier Viz)
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# ─── Base de données (PostgreSQL + pgvector) ──────────────────
# En Docker, l'hôte est le nom du service : postgres
# Sans PostgreSQL : DATABASE_URL=sqlite+aiosqlite:///./data/nexus.db (créer le dossier data/)
DATABASE_URL=postgresql+asyncpg://atelier:change-me@localhost:5432/atelier_nexus
# Migrations appliquées au démarrage (agents personnalisés) ; sans base, les experts restent utilisables
DB_AUTO_MIGRATE=true

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Routeur LLM ──────────────────────────────────────────────
# Fournisseur par défaut : anthropic | ollama
LLM_DEFAULT_PROVIDER=anthropic
# Secours en cas de panne transitoire (réseau, surcharge, 5xx) : anthropic | ollama | vide
LLM_FALLBACK_PROVIDER=ollama

# Anthropic (Claude) — sans clé, le provider est marqué « non configuré »
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TIMEOUT=120

# Ollama (modèles locaux) — natif : 11434 · conteneur du compose : 11435 · en Docker : http://ollama:11434
# Le modèle doit gérer les outils (tool calling) : llama3.1, qwen3, mistral-nemo…
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=300

# ─── Apps Atelier ─────────────────────────────────────────────
# Data Via = API d'Atelier Viz (lancer Viz : cd backend && uvicorn main:app)
# En Docker, le compose la remplace par http://host.docker.internal:8000/api
DATA_VIA_BASE_URL=http://127.0.0.1:8000/api
# Jeton facultatif (envoyé en Bearer ; Atelier Viz n'en exige pas aujourd'hui)
DATA_VIA_API_KEY=
DATA_VIA_TIMEOUT=30

# Atelier Projets (API sur 3000) et Atelier Trésorerie (5050) ; vide = connecteur désactivé
PROJETS_BASE_URL=http://127.0.0.1:3000/api
TRESORERIE_BASE_URL=http://127.0.0.1:5050/api
# Atelier Ciné (mode serveur 4000 ; app Mac 47321)
CINE_BASE_URL=http://127.0.0.1:4000/api
# Atelier Savoir : 5050 est pris par Trésorerie, lancer Savoir avec ATELIER_PORT=5051
SAVOIR_BASE_URL=http://127.0.0.1:5051/api
# Atelier Tab : pas d'API, lecture des instantanés publiés par l'app de bureau
TAB_EXPORTS_DIR=~/Atelier_Tab/exports
TAB_MAX_SNAPSHOT_MB=50
APPS_TIMEOUT=20

# ─── GitHub (agent Développeur) ─────────────────────────────────
# Jeton « fine-grained » limité aux dépôts voulus : Contents + Pull requests en lecture/écriture
GITHUB_TOKEN=
# Dépôt par défaut (propriétaire/dépôt) et autres dépôts autorisés, séparés par des virgules
GITHUB_REPO=
GITHUB_ALLOWED_REPOS=
GITHUB_API_URL=https://api.github.com
