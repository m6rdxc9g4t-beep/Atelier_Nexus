# ─── Application ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# Origines autorisées (CORS), séparées par des virgules
# Nexus : UI 3100 / API 8100 (3000 et 8000 sont réservés à Atelier Projets et Atelier Viz)
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# ─── Validation des actions (docs/settings.md) ─────────────────
# every_step (défaut, recommandé) : toute action d'agent ou étape de workflow, lectures
# comprises, attend « Autoriser » ; writes_only : seulement les écritures
APPROVAL_MODE=every_step

# ─── Base de données (PostgreSQL + pgvector) ──────────────────
# En Docker, l'hôte est le nom du service : postgres
# Sans PostgreSQL : DATABASE_URL=sqlite+aiosqlite:///./data/nexus.db (créer le dossier data/)
DATABASE_URL=postgresql+asyncpg://atelier:change-me@localhost:5432/atelier_nexus
# Migrations appliquées au démarrage (agents personnalisés) ; sans base, les experts restent utilisables
DB_AUTO_MIGRATE=true

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Routeur LLM ──────────────────────────────────────────────
# Fournisseur par défaut : anthropic | ollama
LLM_DEFAULT_PROVIDER=anthropic
# Secours en cas de panne transitoire (réseau, surcharge, 5xx) : anthropic | ollama | vide
LLM_FALLBACK_PROVIDER=ollama

# Anthropic (Claude) — sans clé, le provider est marqué « non configuré »
# Accès à Claude : auto (clé API si renseignée, sinon abonnement par Claude Code), cli, api
# Abonnement Claude (Pro, Max…) : installez Claude Code et lancez « claude » une fois pour vous connecter
CLAUDE_MODE=auto
CLAUDE_CLI_MODEL=sonnet
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TIMEOUT=120

# Ollama (modèles locaux) — natif : 11434 · conteneur du compose : 11435 · en Docker : http://ollama:11434
# Le modèle doit gérer les outils (tool calling) : llama3.1, qwen3, mistral-nemo…
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=300

# ─── Apps Atelier ─────────────────────────────────────────────
# Data Via = API d'Atelier Viz (lancer Viz : cd backend && uvicorn main:app)
# En Docker, le compose la remplace par http://host.docker.internal:8000/api
DATA_VIA_BASE_URL=http://127.0.0.1:8000/api
# Jeton facultatif (envoyé en Bearer ; Atelier Viz n'en exige pas aujourd'hui)
DATA_VIA_API_KEY=
DATA_VIA_TIMEOUT=30

# Atelier Projets (API sur 3000) et Atelier Trésorerie (5050) ; vide = connecteur désactivé
PROJETS_BASE_URL=http://127.0.0.1:3000/api
TRESORERIE_BASE_URL=http://127.0.0.1:5050/api
# Jeton ATELIER_IMPORT_TOKEN d'Atelier Projets, si l'import depuis Atelier Tab est protégé
PROJETS_IMPORT_TOKEN=
# Atelier Ciné (mode serveur 4000 ; app Mac 47321)
CINE_BASE_URL=http://127.0.0.1:4000/api
# Atelier Savoir : 5050 est pris par Trésorerie, lancer Savoir avec ATELIER_PORT=5051
SAVOIR_BASE_URL=http://127.0.0.1:5051/api
# Atelier Tab : pas d'API, lecture des instantanés publiés par l'app de bureau
TAB_EXPORTS_DIR=~/Atelier_Tab/exports
TAB_MAX_SNAPSHOT_MB=50
# Écriture dans Tab par son serveur MCP (vide = lecture seule). App Mac :
#   /Applications/Atelier_Tab.app/Contents/Resources/atelier-mcp
# Depuis le dépôt (après npm run build:desktop) : node /chemin/atelier-tab/dist-desktop/atelier-mcp.mjs
TAB_MCP_COMMAND=
# Dossier de données de Tab (vide = ~/Atelier_Tab) ; TAB_EXPORTS_DIR = <ce dossier>/exports
TAB_DATA_DIR=
TAB_MCP_TIMEOUT=30
APPS_TIMEOUT=20

# Atelier Cuisine : app EN LIGNE (Supabase), lecture seule (docs/apps/cuisine.md). Tout vide = désactivé.
# Adresse du projet (Supabase → Project Settings → API) et clé PUBLIQUE (publishable / anon) :
# jamais la clé service_role ni une clé sb_secret_… (refusées).
CUISINE_SUPABASE_URL=
CUISINE_SUPABASE_ANON_KEY=
# Compte du foyer : e-mail + mot de passe, OU un jeton de rafraîchissement (renouvelé ensuite)
CUISINE_EMAIL=
CUISINE_PASSWORD=
CUISINE_REFRESH_TOKEN=
# Session en cours (jetons tournants, fichier 600) ; vide = cuisine-session.json à côté de ce .env
CUISINE_SESSION_FILE=

# ─── GitHub (agent Développeur) ─────────────────────────────────
# Jeton « fine-grained » limité aux dépôts voulus : Contents + Pull requests en lecture/écriture
GITHUB_TOKEN=
# Dépôt par défaut (propriétaire/dépôt) et autres dépôts autorisés, séparés par des virgules
GITHUB_REPO=
GITHUB_ALLOWED_REPOS=
GITHUB_API_URL=https://api.github.com

# ─── Déclencheurs de workflows (docs/workflows.md, Étape 20) ────
# Fuseau des horaires quotidiens (nom IANA) ; heure d'été / d'hiver gérées automatiquement
TIMEZONE=Europe/Paris
# Tâche de fond (horaires, événements de Viz / Projets / Tab) et intervalle entre deux passages
TRIGGERS_ENABLED=true
TRIGGERS_POLL_SECONDS=15

# Extensions (modules Python installés dans l'environnement du backend), séparées par des virgules.
# Rien n'est chargé sans être nommé ici. Ex. Agent_DatAnalyst : pip install -e ../Agent_DatAnalyst
# NEXUS_PLUGINS=atelier_datanalyst
NEXUS_PLUGINS=
# Réglage lu par l'extension Agent_DatAnalyst : Atelier Convert (API sur 8010)
# CONVERT_BASE_URL=http://127.0.0.1:8010/api
